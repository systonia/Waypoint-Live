{
    "name": "systonia/waypoint-live",
    "description": "Live components for Waypoint under Tenma: server-side PHP components, events and renders over one WebSocket, services called directly.",
    "type": "library",
    "license": ["MIT", "Apache-2.0"],
    "require": {
        "php": ">=8.5",
        "systonia/waypoint": "^1.5.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "tenma/stubs": "^0.1.1"
    },
    "autoload": {
        "psr-4": {
            "Waypoint\\Live\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waypoint\\Live\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "stan": "phpstan analyse"
    }
}
