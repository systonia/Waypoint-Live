{
    "name": "systonia/waypoint-live",
    "description": "Live components for Waypoint under Tenma: server-side PHP components, events and renders over one WebSocket, services called directly.",
    "type": "library",
    "license": ["MIT", "Apache-2.0"],
    "require": {
        "php": ">=8.5",
        "systonia/waypoint": "^0.7.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "tenma/stubs": "^0.1.15"
    },
    "autoload": {
        "psr-4": {
            "Waypoint\\Live\\": "src/"
        },
        "files": [
            "src/classes.php"
        ]
    },
    "bin": [
        "bin/live-check"
    ],
    "autoload-dev": {
        "psr-4": {
            "Waypoint\\Live\\Tests\\": "tests/"
        }
    },
    "extra": {
        "tenma": {
            "lsp": "Waypoint\\Live\\Editor"
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "stan": "phpstan analyse",
        "reference": "tenma docs src/*.php src/Testing --out docs/reference"
    }
}
